{
    "redirects": [
        {
            "source": "/website-hmps.html",
            "destination": "/page",
            "permanent": true
        },
        {
            "source": "/",
            "destination": "/page",
            "permanent": true
        },
        {
            "source": "/index.html",
            "destination": "/page",
            "permanent": true
        },
        {
            "source": "/page/beranda.html",
            "destination": "/page",
            "permanent": true
        },
        {
            "source": "/page/",
            "destination": "/page",
            "permanent": true
        },
        {
            "source": "/admin.html",
            "destination": "/page/admin.html",
            "permanent": true
        },
        {
            "source": "/pedoman.html",
            "destination": "/page/pedoman.html",
            "permanent": true
        },
        {
            "source": "/Pengurus-Harian.html",
            "destination": "/page/pengurus.html",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/page",
            "destination": "/page/beranda.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://images.unsplash.com https://*.supabase.co https://mustikapayment.com https://zapay.zannmods.net; connect-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains"
                }
            ]
        }
    ]
}
